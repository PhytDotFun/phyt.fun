{
    "name": "phyt.fun",
    "private": true,
    "scripts": {
        "build": "turbo run build",
        "clean": "pnpm run clean",
        "contracts:deploy": "pnpm --filter @phyt/contracts deploy",
        "contracts:test": "pnpm --filter @phyt/contracts test",
        "db:generate": "pnpm --filter @phyt/data-access db:generate",
        "db:migrate": "pnpm --filter @phyt/data-access db:migrate",
        "db:seed": "pnpm --filter @phyt/data-access db:seed",
        "db:studio": "pnpm --filter @phyt/data-access db:studio",
        "dev": "turbo run dev",
        "flush": "rm -rf node_modules && rm -rf .turbo && pnpm store prune",
        "lint": "pnpm syncpack lint --dependency-types prod,dev && turbo run lint",
        "lint:fix": "pnpm syncpack fix --dependency-types prod,dev && turbo run lint:fix",
        "postinstall": "pnpm --filter @phyt/contracts deps:install",
        "prepare": "husky",
        "redis:down": "docker stop redis-dev 2>/dev/null || true && docker rm redis-dev 2>/dev/null || true",
        "redis:up": "docker start redis-dev 2>/dev/null || docker run -d --name redis-dev -p 6379:6379 redis:7-alpine"
    },
    "devDependencies": {
        "@changesets/cli": "catalog:",
        "@commitlint/cli": "catalog:",
        "@commitlint/config-conventional": "catalog:",
        "@turbo/gen": "catalog:",
        "concurrently": "catalog:",
        "husky": "catalog:",
        "lint-staged": "catalog:",
        "neonctl": "catalog:",
        "prettier": "catalog:",
        "rimraf": "catalog:",
        "syncpack": "catalog:",
        "tsx": "catalog:",
        "turbo": "^2.5.8"
    },
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@10.19.0"
}
