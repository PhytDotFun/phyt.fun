{{- /* tooling/vault/templates/pgbouncer.ctmpl
     Rendered by Vault Agent to /vault/secrets/pgbouncer.ini
     ENV behavior:
       - VAULT_ENV=staging -> auth_type=trust
       - otherwise         -> scram + auth_query
     NOTE: This template intentionally avoids non-core funcs like "default" or "or".
*/ -}}

{{- $dep := env "DEPLOYMENT_ID" -}}
{{- $env := env "VAULT_ENV" -}}

{{- with secret (env "POSTGRES_SECRET_PATH") -}}
{{-   $pg := .Data.data -}}

{{- with secret (env "PGBOUNCER_SECRET_PATH") -}}
{{-   $pb := .Data.data -}}

[databases]
; In prod avoid embedding user/password here—app supplies its own creds.
; In staging (trust), user/password also not needed.

appdb = host={{- if $pb.DATABASE_HOST -}}{{ $pb.DATABASE_HOST }}{{- else -}}postgres{{- end -}} \
port={{- if $pb.DATABASE_PORT -}}{{ $pb.DATABASE_PORT }}{{- else -}}5432{{- end -}} \
dbname={{- if $pb.DATABASE_NAME -}}{{ $pb.DATABASE_NAME }}{{- else if $pg.POSTGRES_DB -}}{{ $pg.POSTGRES_DB }}{{- else -}}app{{- end -}}{{- if $pb.DATABASES_SSLMODE -}} \
sslmode={{ $pb.DATABASE_SSLMODE }}{{- end }}

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = 6432
unix_socket_dir = /var/run/postgresql

pool_mode = transaction
server_reset_query = DISCARD ALL
max_client_conn = 1000
default_pool_size = 50
min_pool_size = 5
reserve_pool_size = 10
reserve_pool_timeout = 5
max_db_connections = 0
max_user_connections = 0
ignore_startup_parameters = extra_float_digits

{{- if eq $env "staging" }}
; ── STAGING: simplest posture (no userlist) ─────────────────────────────────────
auth_type = trust
server_tls_sslmode = disable
{{- else }}
; ── PROD: DB-side auth (no app creds in .ini) ───────────────────────────────────
auth_type = scram-sha-256
auth_user = {{- if $pb.AUTH_USER -}}{{ $pb.AUTH_USER }}{{- else -}}pgbouncer_auth{{- end }}
auth_query = {{- if $pb.AUTH_QUERY -}}{{ $pb.AUTH_QUERY }}{{- else -}}SELECT username, password FROM pgbouncer.get_auth($1){{- end }}
; Optional client TLS to PgBouncer (enable if terminating TLS here)
; client_tls_sslmode = {{- if $pb.CLIENT_TLS_SSLMODE -}}{{ $pb.CLIENT_TLS_SSLMODE }}{{- else -}}disable{{- end }}
{{- end }}

server_fast_close = 1
query_timeout = 60
tcp_keepalive = 1
tcp_keepidle = 30
tcp_keepintvl = 10
tcp_keepcnt = 3

; No [users] section required (trust in staging; auth_query in prod)

{{-     end -}}
{{- end -}}
